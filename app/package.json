{
  "name": "terrarium-desktop",
  "productName": "Terrarium",
  "version": "0.2.0-beta.4",
  "description": "Terrarium 하네스 데스크톱 앱 (관제탑 화면: 코디네이터 터미널과 하달된 만큼만 뜨는 오퍼레이터·워커 창, 계정 연결, 실행 폴더 설치, 진행 기록)",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/lib.test.mjs test/flow.test.mjs test/testgo.test.mjs test/updater.test.mjs test/limits.test.mjs",
    "smoke": "node test/smoke.mjs",
    "dist": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "electron-updater": "6.8.11",
    "node-pty": "1.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "electron": "45.2.2",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "dev.terrarium.desktop",
    "productName": "Terrarium",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "lib/**",
      "renderer/**",
      "tower/**",
      "package.json"
    ],
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/node-pty/**",
      "lib/statusline.mjs"
    ],
    "extraResources": [
      {
        "from": "../harness",
        "to": "harness",
        "filter": [
          "**/*",
          "!test/**",
          "!e2e/scenarios/**",
          "!**/.env",
          "!**/.env.*",
          "!**/*.log",
          "!**/node_modules/**"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "WooCH16",
        "repo": "Terrarium_",
        "releaseType": "prerelease"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
